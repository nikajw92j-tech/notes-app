# ---------------------------------------------------------------
# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" (legacy) or "publishable" key. Safe for the browser — RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by DELETE /api/account. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used to build auth email / OAuth redirect links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Integration tests only (use a separate TEST project, not production)
# ---------------------------------------------------------------
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
# TEST_APP_URL=http://localhost:3000
